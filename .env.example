APP_ENV=development
DATABASE_URL=sqlite:///./aipeiisr.db
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
SEARCH_PROVIDER=internal
AUTH_SECRET=replace-in-production
JWT_SECRET=
JWT_ALGORITHM=HS256
X_ROLE_ENABLED=true
# Auth0 production OIDC settings. Set all three and set X_ROLE_ENABLED=false
# outside local development. Never put a Client Secret in this file.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ROLES_CLAIM=https://api.aipeiisr.local/roles
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMB_MODEL=nomic-embed-text
HF_API_TOKEN=
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
AI_TIMEOUT_SECONDS=10
WORKER_DISABLED=
SCHEDULER_DISABLED=
WORKER_NAME=worker-1
WORKER_POLL_SECONDS=2
